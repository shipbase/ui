---
import { siteConfig } from "@/config/site"
import RootLayout from "@/layouts/root-layout.astro"
---

<RootLayout
  metadata={{
    title: "Page Not Found",
    description: siteConfig.description,
    openGraph: {
      type: "website",
      title: "Page Not Found",
      description: siteConfig.description,
      url: String(Astro.url),
      siteName: siteConfig.name,
      image: { url: siteConfig.ogImage, alt: "Page Not Found" },
    },
    twitter: {
      card: "summary_large_image",
      title: "Page Not Found",
      description: siteConfig.description,
      creator: siteConfig.creator,
      image: { url: siteConfig.twitterImage, alt: "Page Not Found" },
    },
  }}
>
  <div class="container py-16 text-center">
    <h1 class="text-4xl font-bold tracking-tight">404 – Page not found</h1>
    <p class="mt-2 text-muted-foreground">The page you’re looking for doesn’t exist.</p>
  </div>
</RootLayout>
