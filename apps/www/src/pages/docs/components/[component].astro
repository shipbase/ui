---
import { getCollection, render } from "astro:content"
import type { GetStaticPaths } from "astro"

import { MDXComponents } from "@/components/content"
import { siteConfig } from "@/config/site"
import DocLayout from "@/layouts/doc-layout.astro"
import RootLayout from "@/layouts/root-layout.astro"

export const prerender = true

export const getStaticPaths = (async () => {
  const components = await getCollection("components")

  return components.map((component) => {
    return {
      params: {
        component: component.id,
      },
      props: {
        entry: component,
      },
    }
  })
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const ogImage = `/og?title=${encodeURIComponent(entry.data.title)}&description=${encodeURIComponent(entry.data.description)}`
---

<RootLayout
  metadata={{
    title: entry.data.title,
    description: entry.data.description ?? siteConfig.description,
    openGraph: {
      type: "website",
      title: entry.data.title,
      description: entry.data.description ?? siteConfig.description,
      url: String(Astro.url),
      siteName: siteConfig.name,
      image: { url: ogImage, alt: entry.data.title },
    },
    twitter: {
      card: "summary_large_image",
      title: entry.data.title,
      description: entry.data.description ?? siteConfig.description,
      creator: siteConfig.creator,
      image: { url: ogImage, alt: entry.data.title },
    },
  }}
>
  <DocLayout
    title={entry.data.title}
    description={entry.data.description}
    headings={headings}
  >
    <Content components={MDXComponents} />
  </DocLayout>
</RootLayout>
