---
import { getCollection } from "astro:content"
import type { GetStaticPaths } from "astro"

import RootLayout from "@/layouts/root-layout.astro"

export const getStaticPaths = (async () => {
  const collections = await getCollection("components")
  return collections.flat(1).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}) satisfies GetStaticPaths
const { entry } = Astro.props
---

<RootLayout title={`${entry.data.title} Examples`} description={entry.data.description}>
  <div
    class="container md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-6 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-10"
  >
  </div>
</RootLayout>
