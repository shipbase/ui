---
import ExampleCards from "../example-cards/index.astro"
---

<section class="relative overflow-hidden">
  <div class="p-6 xs:p-8 flex flex-col gap-4">
    <h3 class="text-3xl font-bold">Everything you need to build</h3>
    <p class="text-muted-foreground leading-relaxed">
      A comprehensive component library with 30+ production-ready components,
      rich examples, and ready-to-use blocks. Built on Ark UI primitives with
      accessibility and customization at the core. From basic inputs to complex
      data tables, speed up development with battle-tested components and
      pre-built sections.
    </p>
  </div>

  <!-- Component Examples Section -->
  <div class="p-6 xs:p-8 pt-0">
    <ExampleCards />
  </div>
</section>
