---
import { siteConfig } from "@/config/site"
---

<footer
  class="before:bg-[linear-gradient(to_right,--theme(--color-border/.3),--theme(--color-border)_200px,--theme(--color-border)_calc(100%-200px),--theme(--color-border/.3))] relative py-6 before:absolute before:-inset-x-32 before:top-0 before:h-px"
>
  <div
    class="container flex flex-col items-center justify-center gap-4 md:h-16 md:flex-row"
  >
    <p
      class="text-balance text-center md:text-sm leading-loose text-muted-foreground md:text-left text-xs"
    >
      Built by
      <a
        href={siteConfig.links.twitter}
        target="_blank"
        rel="noreferrer"
        class="font-medium underline underline-offset-4"
      >
        iamdin
      </a>
      . The source code is available on
      <a
        href={siteConfig.links.github}
        target="_blank"
        rel="noreferrer"
        class="font-medium underline underline-offset-4"
      >
        GitHub
      </a>
      .
    </p>
  </div>
</footer>
