---
import Code from "@/components/code.astro"
import { getComponentPageParams } from "@/lib/docs"
import { getExampleSource } from "@/lib/source"
import { cn } from "@/lib/utils"
import PreviewReact from "./preview"
import Tabs from "./tabs"

export interface Props {
  name: string
  className?: string
}
const { name, className } = Astro.props

// Get type-safe framework parameter
const { framework } = getComponentPageParams(Astro.params)

const { source, lang } = (await getExampleSource(framework, name)) || {}
---

<div
  class={cn(
    "relative my-4 flex flex-col space-y-2 lg:max-w-[120ch]",
    className
  )}
>
  <Tabs client:load>
    <Fragment slot="preview">
      <PreviewReact client:load name={name} />
    </Fragment>
    <Fragment slot="code">
      {
        source ? (
          <Code
            className="mt-0 h-[450px] overflow-y-auto"
            lang={lang}
            src={source}
          />
        ) : (
          <Code src={"Not Found"} />
        )
      }
    </Fragment>
  </Tabs>
</div>
