---
import { cn } from "@/lib/utils"
import ComponentCode from "./component-code.astro"
import Preview from "./preview"
import Tabs from "./tabs"

export interface Props {
  name: string
  className?: string
}
const { name, className } = Astro.props

// // Get type-safe framework parameter
// const { framework } = getComponentPageParams(Astro.params)

// const { source, lang } = (await getExampleSource(framework, name)) || {}
---

<div
  class={cn(
    "relative my-4 flex flex-col space-y-2 lg:max-w-[120ch]",
    className
  )}
>
  <Tabs client:load>
    <Fragment slot="preview">
      <div
        class="relative flex size-full h-[450px] w-full items-center justify-center rounded border p-4 md:p-10"
      >
        <Preview client:only="react" name={name} />
      </div>
    </Fragment>
    <Fragment slot="code">
      <!-- {
        source ? (
          <Code
            className="mt-0 h-[450px] overflow-y-auto"
            lang={lang}
            src={source}
          />
        ) : (
          <Code src={"Not Found"} />
        )
      } -->
      <ComponentCode server:defer name={name} />
    </Fragment>
  </Tabs>
</div>
