---
import { PackageInstallBashCommand } from "./package-install-bash-command.tsx"

interface Props {
  command: string
}

const { command } = Astro.props

const commandMap = {
  npm: command,
  pnpm: command.replace(/^npm install/g, "pnpm add"),
  yarn: command.replace(/^npm install/g, "yarn add"),
  bun: command.replace(/^npm install/g, "bun add"),
}
---

<PackageInstallBashCommand commandMap={commandMap} client:visible />