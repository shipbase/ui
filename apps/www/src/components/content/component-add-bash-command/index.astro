---
import { ComponentAddBashCommand } from "./component-add-bash-command.tsx"

interface Props {
  name: string
}

const { name } = Astro.props

const HOST = "http://shipbase-ui.pages.dev"
const base = `npx shadcn@latest add ${HOST}/r/react/${name}.json`

const commandMap = {
  npm: base,
  pnpm: base.replace(/^npx/g, "pnpm dlx"),
  yarn: base.replace(/^npx/g, "yarn dlx"),
  bun: base.replace(/^npx/g, "bunx --bun"),
}
---

<ComponentAddBashCommand commandMap={commandMap} client:load />
