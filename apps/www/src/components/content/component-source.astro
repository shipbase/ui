---
import Code from "@/components/code.astro"
import CodeCollapsible from "@/components/content/code-collapsible"
import { frameworks } from "@/constants/frameworks"
import { getComponentSource } from "@/lib/source"

export interface Props {
  name: string
}
const { name } = Astro.props

const frameworkSources = await Promise.all(
  frameworks.map((framework) => getComponentSource(framework, name))
)
---

{
  frameworks?.map((framework, index) => {
    const sources = frameworkSources[index];
    return (
      <div data-framework={framework} class="hidden">
        {sources?.length && sources.length > 0 ? (
          sources?.map((source) => (
            <Fragment>
              {typeof sources?.length === "number" && sources?.length > 1 ? (
                <p class="mb-2">{source.filename}</p>
              ) : null}
              <CodeCollapsible client:load>
                <Code
                  lang={source.lang}
                  src={source.content}
                  className="[&>pre]:pb-10"
                />
              </CodeCollapsible>
            </Fragment>
          ))
        ) : (
          <Code src="Not supported yet" className="[&>pre]:pb-10" />
        )}
      </div>
    );
  })
}
