---
import Code from "@/components/code.astro"
import CodeCollapsible from "@/components/content/code-collapsible"
import { getComponentPageParams } from "@/lib/docs"
import { getComponentSource } from "@/lib/source"

export interface Props {
  component: string
}
const { component } = Astro.props

// Get current framework from type-safe params
const { framework: currentFramework } = getComponentPageParams(Astro.params)

// Only get source for current framework
const frameworkSources = await getComponentSource(currentFramework, component)
---

<div class="mt-4">
  {frameworkSources?.length ? (
    frameworkSources?.map((src) => (
      <Fragment>
        {typeof frameworkSources?.length === "number" &&
        frameworkSources?.length > 1 ? (
          <p class="mb-2">{src.filename}</p>
        ) : null}
        <CodeCollapsible client:load>
          <Code
            lang={src.lang}
            src={src.source}
            className="[&>pre]:pb-10"
          />
        </CodeCollapsible>
      </Fragment>
    ))
  ) : (
    <Code src={"Not Found"} />
  )}
</div>
