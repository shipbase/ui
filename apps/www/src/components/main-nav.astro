---
import { siteConfig } from "@/config/site"
import { cn } from "@/lib/utils"
import LogoDark from "../../public/logo-dark.svg"
import Logo from "../../public/logo.svg"

const pathname = Astro.url.pathname
---

<div class="mr-4 hidden md:flex">
  <a
    href="/"
    class="mr-4 flex items-center space-x-2 lg:mr-6 text-sm font-medium text-muted-foreground"
  >
    <Logo class="block dark:hidden size-4" />
    <LogoDark class="hidden dark:block size-4" />
    <span class="hidden font-bold lg:inline-block text-primary">
      <span class="hidden font-bold lg:inline-block text-primary">
        {siteConfig.name}
      </span>
    </span>
  </a>
  <nav class="flex items-center gap-4 text-sm lg:gap-6">
    <a
      href="/docs/introduction"
      class={cn(
        "transition-colors hover:text-foreground/80",
        pathname?.startsWith("/docs") &&
          !pathname?.startsWith("/docs/components")
          ? "text-foreground"
          : "text-foreground/60"
      )}
    >
      Docs
    </a>
    <a
      href="/docs/components/accordion"
      class={cn(
        "transition-colors hover:text-foreground/80",
        pathname?.startsWith("/docs/components")
          ? "text-foreground"
          : "text-foreground/60"
      )}
    >
      Components
    </a>
  </nav>
</div>
