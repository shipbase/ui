---
import { generateComponentSideItems, getComponentPageParams } from "@/lib/docs"
import { cn } from "@/lib/utils"

// Get type-safe framework parameter with default fallback
const { framework } = getComponentPageParams(Astro.params)

const sidebarGroup = [
  {
    title: "Get Started",
    items: [
      {
        title: "Introduction",
        href: "/docs/introduction",
      },
      {
        title: "Installation",
        href: "/docs/installation",
      },
    ],
  },
  {
    title: "Components",
    items: await generateComponentSideItems(framework),
  },
]

const pathname = Astro.url.pathname
---

{
  sidebarGroup.map((group) => (
    <div class="pb-4">
      <h4 class="mb-1 px-2 py-1 text-sm font-semibold">{group.title}</h4>
      <div class="flex flex-col text-sm">
        {group.items.map((item) => (
          <a
            href={item.href}
            class={cn(
              "hover:underline px-2 py-1",
              pathname.startsWith(item.href)
                ? "font-medium text-foreground"
                : "text-muted-foreground"
            )}
          >
            {item.title}
          </a>
        ))}
      </div>
    </div>
  ))
}
